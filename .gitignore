node_modules
dist
.DS_Store
*.log

# Rust / Tauri
src-tauri/target
src-tauri/gen
# NOTE: src-tauri/Cargo.lock is deliberately COMMITTED (r148). This crate
# builds a signed, distributed BINARY, not a library — the lockfile is what
# makes "the code we audited" and "the code we shipped" the same thing, and
# it is what THIRD-PARTY-LICENSES.md points reviewers at. package-lock.json
# has always been committed for exactly this reason; the Rust side was
# ignored by oversight, which meant ~780 crates behind caret ranges resolved
# fresh on every clone, every CI run, and every release build.

# Swift sidecar (saucebunny-diarize) — SwiftPM artifacts + the resolved
# manifest. Built locally per-machine via `npm run build:diarizer`.
swift-sidecar/.build
swift-sidecar/.swiftpm

# Sidecar binaries — NOT checked in (was ~150 MB of git blobs and every
# refresh added another version to history). Fetched/built locally via
# `npm run setup` (see scripts/setup.sh); CI stubs them for cargo check.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Local
.env
.env.local

# Build artifacts (generated — vite.config.ts is the real source)
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Playwright e2e output (generated by `npm run test:e2e`)
test-results/
playwright-report/

# Editor/agent-local config (machine-specific, not shared)
.claude/

# Internal design notes / working docs (personal paths, session transcripts)
# — deliberately local-only, never part of the public tree.
_design/
