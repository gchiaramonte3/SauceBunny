node_modules
dist
.DS_Store
*.log

# Rust / Tauri
src-tauri/target
src-tauri/Cargo.lock
src-tauri/gen

# Swift sidecar (saucebunny-diarize) — SwiftPM artifacts + the resolved
# manifest. Built locally per-machine via `npm run build:diarizer`.
swift-sidecar/.build
swift-sidecar/.swiftpm

# Sidecar binaries — NOT checked in (was ~150 MB of git blobs and every
# refresh added another version to history). Fetched/built locally via
# `npm run setup` (see scripts/setup.sh); CI stubs them for cargo check.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Local
.env
.env.local

# Build artifacts (generated — vite.config.ts is the real source)
*.tsbuildinfo
vite.config.js
vite.config.d.ts
