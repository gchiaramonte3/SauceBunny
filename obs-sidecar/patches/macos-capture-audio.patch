--- a/mac-sck-video-capture.m
+++ b/mac-sck-video-capture.m
@@ -1,6 +1,18 @@
 #include "mac-sck-common.h"
 #include "window-utils.h"
 
+// This is an acquisition policy, not a monitoring/output-volume control.
+// Return the same flag used for audio-output registration below.
+API_AVAILABLE(macos(13.0)) bool sauce_capture_configure_audio(obs_data_t *settings,
+                                                          SCStreamConfiguration *configuration)
+{
+    const bool enabled = obs_data_get_bool(settings, "capture_audio");
+    [configuration setCapturesAudio:enabled];
+    [configuration setExcludesCurrentProcessAudio:YES];
+    [configuration setChannelCount:2];
+    return enabled;
+}
+
