+                NSRunningApplication *parent = sauce_display_audio_parent();
+                NSArray *applications = parent ? sauce_capture_display_audio_applications(audio_settings,
+                    sc->shareable_content.applications, exclusions, parent.processIdentifier, parent.bundleIdentifier) : nil;
+                if (!applications) {
+                    obs_data_release(audio_settings);
+                    os_atomic_set_bool(&sc->sauce_capture_terminated, true);
+                    os_sem_post(sc->shareable_content_available);
+                    sc->disp = NULL;
+                    os_event_init(&sc->stream_start_completed, OS_EVENT_TYPE_MANUAL);
+                    return false;
+                }
+                content_filter = [[SCContentFilter alloc] initWithDisplay:target_display
+                    excludingApplications:applications exceptingWindows:exclusions];
+                [sc->stream_properties setSampleRate:48000];
+            } else {
+                content_filter = [[SCContentFilter alloc] initWithDisplay:target_display excludingWindows:exclusions];
+            }
+            obs_data_release(audio_settings);
 
             obs_data_t *region_settings = obs_source_get_settings(sc->source);
             const bool region_ready = sauce_capture_display_region(region_settings, target_display, sc->stream_properties);
