@@ -1,6 +1,53 @@
 #include "mac-sck-common.h"
 #include "window-utils.h"
 #include "sauce-display-crop.h"
+#include "sauce-display-audio.h"
+
+// Metadata-only resolver, exercised without constructing a stream. Actual
+// parent values come from getppid/NSRunningApplication at the call site, not
+// from a renderer-selected bundle or process. A same-name app is not enough.
+API_AVAILABLE(macos(12.5)) NSArray *sauce_capture_display_audio_applications(obs_data_t *settings,
+    NSArray<SCRunningApplication *> *applications, NSArray<SCWindow *> *overlays,
+    pid_t actual_parent, NSString *actual_parent_bundle)
+{
+    if (!settings || !obs_data_get_bool(settings, "capture_audio") || actual_parent <= 1 ||
+        actual_parent == getpid() || ![actual_parent_bundle isEqualToString:@"com.saucebunny.desktop"])
+        return nil;
+    const char *integer_keys[] = {"sauce_display_audio_policy", "sauce_audio_parent_pid"};
+    const int64_t integer_values[] = {1, actual_parent};
+    for (unsigned i = 0; i < 2; ++i) {
+        obs_data_item_t *item = obs_data_item_byname(settings, integer_keys[i]);
+        const bool valid = item && obs_data_item_gettype(item) == OBS_DATA_NUMBER &&
+            obs_data_item_numtype(item) == OBS_DATA_NUM_INT &&
+            obs_data_get_int(settings, integer_keys[i]) == integer_values[i];
+        obs_data_item_release(&item);
+        if (!valid) return nil;
+    }
+    if (overlays.count != 4) return nil;
+    NSMutableSet *seen = [NSMutableSet setWithCapacity:4];
+    for (SCWindow *window in overlays) {
+        // Application exclusions are applied BEFORE window exceptions. These
+        // four exceptions REMOVE helper windows only because their owner is
+        // NOT the excluded parent. A parent-owned exception would re-include
+        // its picture/audio and must fail closed.
+        if (!window.windowID || [seen containsObject:@(window.windowID)] ||
+            window.owningApplication.processID != getpid() ||
+            window.owningApplication.processID == actual_parent) return nil;
+        [seen addObject:@(window.windowID)];
+    }
+    SCRunningApplication *parent = nil;
+    for (SCRunningApplication *application in applications) {
+        if (application.processID != actual_parent) continue;
+        if (parent || ![application.bundleIdentifier isEqualToString:actual_parent_bundle]) return nil;
+        parent = application;
+    }
+    return parent ? @[parent] : nil;
+}
+
+// See Apple's SCContentFilter excludingApplications:exceptingWindows: rules.
+// Do not exclude the helper application too: that would make its four window
+// exceptions INCLUDE the desktop overlay again. Current-process audio is
+// excluded separately by sauce_capture_configure_audio.
 
 // Geometry is frozen by the chooser and revalidated again immediately before
 // SCStream creation. No fullscreen fallback for a missing/changed region.
@@ -226,6 +273,25 @@
                 return false;
             }
