@@ -1,3 +1,37 @@
 #include "mac-sck-common.h"
 #include "window-utils.h"
+#include "sauce-display-crop.h"
+
+// Geometry is frozen by the chooser and revalidated again immediately before
+// SCStream creation. No fullscreen fallback for a missing/changed region.
+API_AVAILABLE(macos(12.5)) bool sauce_capture_display_region(obs_data_t *settings,
+    SCDisplay *display, SCStreamConfiguration *configuration)
+{
+    const char *required[] = {"sauce_display_x", "sauce_display_y", "sauce_display_width", "sauce_display_height",
+        "sauce_display_pixel_width", "sauce_display_pixel_height", "sauce_region_x", "sauce_region_y",
+        "sauce_region_width", "sauce_region_height"};
+    for (unsigned i = 0; i < 10; i++) if (!obs_data_has_user_value(settings, required[i])) return false;
+    if (!display || !CGDisplayIsActive(display.displayID)) return false;
+    const CGRect bounds = CGDisplayBounds(display.displayID);
+    CGDisplayModeRef mode = CGDisplayCopyDisplayMode(display.displayID);
+    if (!mode) return false;
+    const size_t pixels_wide = CGDisplayModeGetPixelWidth(mode), pixels_high = CGDisplayModeGetPixelHeight(mode);
+    CGDisplayModeRelease(mode);
+    if (bounds.origin.x != obs_data_get_double(settings, "sauce_display_x") ||
+        bounds.origin.y != obs_data_get_double(settings, "sauce_display_y") ||
+        bounds.size.width != obs_data_get_double(settings, "sauce_display_width") ||
+        bounds.size.height != obs_data_get_double(settings, "sauce_display_height") ||
+        pixels_wide != obs_data_get_double(settings, "sauce_display_pixel_width") ||
+        pixels_high != obs_data_get_double(settings, "sauce_display_pixel_height")) return false;
+    struct sauce_display_crop crop;
+    if (!sauce_display_crop_make(bounds.size.width, bounds.size.height, pixels_wide, pixels_high,
+        obs_data_get_double(settings, "sauce_region_x"), obs_data_get_double(settings, "sauce_region_y"),
+        obs_data_get_double(settings, "sauce_region_width"), obs_data_get_double(settings, "sauce_region_height"), &crop))
+        return false;
+    [configuration setSourceRect:CGRectMake(crop.x, crop.y, crop.width, crop.height)];
+    [configuration setWidth:crop.pixels_wide];
+    [configuration setHeight:crop.pixels_high];
+    return true;
+}
+
 #include <unistd.h>
