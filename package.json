{
  "name": "sauce-bunny",
  "private": true,
  "version": "0.5.0",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23 || >=24"
  },
  "type": "module",
  "scripts": {
    "design:catalog": "vite --config vite.config.ts --host 127.0.0.1 --port 51731 --open /design-system.html",
    "check:design-catalog": "tsc -p design-system/tsconfig.json && eslint --config design-system/eslint.config.mjs design-system --max-warnings 0 && node scripts/design-catalog-audit.mjs && vitest run --config vite.config.ts design-system/isolation.test.ts && playwright test --config design-system/playwright.config.ts && node scripts/verify-design-catalog-build.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup": "bash scripts/setup.sh",
    "test": "vitest run && npm run test:ndi-packaging && npm run test:ndi-profiling",
    "build:diarizer": "bash scripts/build-diarizer.sh",
    "build:diarizer:universal": "bash scripts/build-diarizer.sh --universal",
    "build:dictate": "bash scripts/build-dictate.sh",
    "build:capture": "bash scripts/build-capture.sh",
    "refresh:sidecars": "bash scripts/refresh-sidecars.sh",
    "verify:sidecars": "bash scripts/verify-sidecars.sh",
    "repin:sidecar": "bash scripts/repin-sidecar.sh",
    "refresh:ffmpeg": "bash scripts/fetch-ffmpeg.sh",
    "refresh:ffprobe": "bash scripts/fetch-ffprobe.sh",
    "build:whisper": "bash scripts/build-whisper.sh",
    "build:llama": "bash scripts/build-llama.sh",
    "check:release": "bash scripts/check-notarization-ready.sh",
    "verify:bundle": "bash scripts/verify-bundle.sh",
    "test:e2e": "playwright test",
    "test:ndi-packaging": "node --test scripts/prepare-ndi-bundle.test.mjs scripts/verify-ndi-package.test.mjs",
    "test:ndi-profiling": "node --test scripts/profile-ndi-processes.test.mjs",
    "set-version": "bash scripts/set-version.sh",
    "lint": "eslint src e2e --max-warnings 0",
    "verify:packaged": "bash scripts/verify-packaged.sh",
    "verify": "bash scripts/verify-all.sh",
    "build:dmg": "bash scripts/detach-stale-dmg.sh && bash scripts/set-version.sh && bash scripts/build-app-with-ndi.sh && npm run verify:bundle && npm run verify:packaged && { bash scripts/archive-dmg.sh || echo \"⚠ the build succeeded but archiving failed; the DMG is only in the build tree\"; }",
    "release:dmg": "bash scripts/release-dmg.sh",
    "check:licenses": "bash scripts/check-licenses.sh",
    "check:changelog": "bash scripts/check-changelog.sh",
    "harness:firstframe": "node harness-firstframe/run.mjs",
    "archive:dmg": "bash scripts/archive-dmg.sh"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.2.7",
    "@mediabunny/mp3-encoder": "^1.52.3",
    "@mediabunny/prores": "^1.52.3",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "mediabunny": "^1.52.3",
    "opus-decoder": "^0.7.11",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
