{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sauce Bunny",
  "version": "0.4.8",
  "identifier": "com.saucebunny.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sauce Bunny",
        "width": 1680,
        "height": 1020,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0E0E10",
        "center": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* asset: http://asset.localhost https://asset.localhost; media-src 'self' https: http: blob: asset: http://asset.localhost http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli",
      "binaries/saucebunny-diarize",
      "binaries/saucebunny-dictate",
      "binaries/saucebunny-capture",
      "binaries/llama-server"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD-PARTY-LICENSES.md": "licenses/THIRD-PARTY-LICENSES.md",
      "../licenses/GPLv3.txt": "licenses/GPLv3.txt",
      "icons/Assets.car": "."
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "bundleVersion": "2026090205"
    },
    "category": "public.app-category.video"
  },
  "plugins": {}
}
